// Shared media and empty states, separate from content files.
.content-section
  margin: 48px 0 96px
.section-title
  color: #1d1d1f
  font-family: font-display
  font-size: clamp(2rem, 4.5vw, 3.25rem)
  font-weight: 600
  letter-spacing: -.045em
  line-height: 1.04
  margin-bottom: 36px
.empty-state
  color: #86868b
  font-size: 1.05rem
  padding: 48px 0
.content-list
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 48px 28px
.content-card
  min-width: 0
  border-top: 1px solid #d2d2d7
  padding: 22px 0 32px
  h2
    margin: 12px 0 16px
    line-height: 1.18
    font-size: clamp(1.35rem, 3vw, 1.8rem)
    font-weight: 600
    letter-spacing: -.025em
  a
    color: #333
    text-decoration: none
  p
    margin: 12px 0
    overflow-wrap: anywhere
.card-meta
  color: #86868b
  font-size: .78em
  letter-spacing: .03em
.card-image img
  width: 100%
  height: 220px
  object-fit: cover
  border-radius: 16px
.photo-grid
  display: grid
  grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr))
  gap: 16px
  margin: 24px 0
  img
    display: block
    width: 100%
    border-radius: 16px
.article-entry video, .article-entry audio
  display: block
  width: 100%
  margin: 20px 0
.article-entry video
  max-height: 70vh
  background: #111
.category-tree
  ul
    margin: 12px 0 12px 24px
  li
    margin: 12px 0
.category-list-count
  margin-left: 8px
  color: #777
.admin-link
  margin-left: 20px
#comments
  margin: 40px 0
.image-viewer
  max-width: 94vw
  max-height: 94vh
  padding: 18px
  border: 0
  border-radius: 6px
  &::backdrop
    background: rgba(0, 0, 0, .8)
  img
    max-width: 86vw
    max-height: 78vh
    display: block
  button
    display: block
    margin-left: auto
    padding: 6px 14px
@media screen and (max-width: 600px)
  .content-list
    grid-template-columns: 1fr
@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    transition: none !important
