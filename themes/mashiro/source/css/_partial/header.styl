#header-title
  text-align: center
  margin: 0 auto
  padding: 150px 24px 76px

$logo-text
  text-decoration: none
  color: #1d1d1f

#logo
  @extend $logo-text
  font-family: font-display
  font-size: clamp(2.8rem, 7vw, 5.5rem)
  font-weight: 650
  letter-spacing: -.055em
  line-height: .95

#subtitle
  @extend $logo-text
  color: #6e6e73
  font-size: clamp(1rem, 2vw, 1.35rem)
  font-weight: 400
  line-height: 1.4

#subtitle-wrap
  margin: 24px 20px 0

#nav-outer
  position: fixed
  top: 0
  left: 0
  width: 100%
  max-width: 100%
  margin: 0 auto
  background: rgba(255,255,255,.86)
  z-index: 20
  border-bottom: 1px solid rgba(0,0,0,.08)
  transition: opacity .45s ease, transform .45s ease

@supports (backdrop-filter: saturate(180%) blur(20px))
  #nav-outer {
    background: rgba(255,255,255,.72)
    backdrop-filter: saturate(180%) blur(20px)
  }

@supports (-webkit-backdrop-filter: saturate(180%) blur(20px))
  #nav-outer {
    background: rgba(255,255,255,.72)
    -webkit-backdrop-filter: saturate(180%) blur(20px)
  }

#main-nav
  display: flex
  align-items: center
  justify-content: space-between
  box-sizing: border-box
  min-height: 48px
  width: calc(100% - 48px)
  max-width: 1160px
  padding: 0 24px

.main-nav-brand
  color: #1d1d1f
  font-size: 14px
  font-weight: 600
  letter-spacing: -.02em
  line-height: 48px
  text-decoration: none

.main-nav-links
  display: flex
  align-items: center
  gap: 22px

$nav-link
  color: #1d1d1f
  text-decoration: none
  transition: color .2s ease
  display: block
  &:hover
    color: #0071e3

.nav-icon
  @extend $nav-link
  font-family: font-icon
  text-align: center
  font-size: 16px
  width: 44px
  height: 44px
  line-height: 44px
  position: relative
  cursor: pointer

.main-nav-link
  @extend $nav-link
  font-size: 11px
  font-weight: 400
  letter-spacing: .01em
  white-space: nowrap

#main-nav-toggle
  display: none
  background: none
  border: 0
  &:before
    content: "\f0c9"

#nav-rss-link
  &:before
    content: "\f09e"

.is-home:not(.home-past-intro) #nav-outer
  opacity: 0
  pointer-events: none
  transform: translateY(-100%)

@media screen and (max-width: 760px)
  #main-nav
    min-height: 48px
    width: 100%
    padding: 0 16px 0 20px
  .main-nav-links
    display: none
  #main-nav-toggle
    display: block
