<!-- 1. 简短感悟（自动读取 _data/thoughts.yml） -->
<% if (site.data.thoughts) { %>
  <section class="home-thoughts" style="padding: 25px; background: #fafafa; border-radius: 12px; margin-bottom: 40px; text-align: center; border: 1px solid #eaeaea;">
    <h3 style="margin-top: 0; color: #555; font-size: 1.1em;">💡 碎碎念</h3>
    <p style="color: #666; line-height: 1.6; margin-bottom: 0;">
      <%= site.data.thoughts.content %>
    </p>
  </section>
<% } %>

<!-- 2. 最新图库入口（自动读取 _data/gallery.yml 前 3 张） -->
<% if (site.data.gallery && site.data.gallery.length > 0) { %>
  <section class="home-gallery-preview" style="margin-bottom: 50px;">
    <h2 style="text-align: center; border-bottom: none; margin-bottom: 20px;">
      <a href="/gallery/" style="color: #333; text-decoration: none; border-bottom: 2px solid #ccc; padding-bottom: 5px;">📷 最新光影</a>
    </h2>
    
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;">
      <% site.data.gallery.slice(0, 3).forEach(function(img){ %>
        <a href="/gallery/">
          <img src="<%= img.url %>" style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px;">
        </a>
      <% }) %>
    </div>
  </section>
  <hr style="border: 0; height: 1px; background-image: linear-gradient(to right, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0)); margin-bottom: 40px;">
<% } %>

<!-- 3. 文章列表 -->
<section class="home-articles">
  <h2 style="text-align: center; border-bottom: none; margin-bottom: 30px;">
    <span style="color: #333; border-bottom: 2px solid #ccc; padding-bottom: 5px;">📝 最新文章</span>
  </h2>
  
  <% page.posts.each(function(post){ %>
    <%- partial('_partial/article', {post: post, index: true}) %>
  <% }) %>
  
  <% if (page.total > 1){ %>
    <nav id="page-nav">
      <%- paginator({
        prev_text: '&laquo; ' + __('prev'),
        next_text: __('next') + ' &raquo;'
      }) %>
    </nav>
  <% } %>
</section>