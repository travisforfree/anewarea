<section class="content-section">
  <h1 class="section-title"><span><%= page.title %></span><% if (page.title_zh) { %><small><%= page.title_zh %></small><% } %></h1>
  <% if (!page.posts.length) { %><p class="empty-state">这里还没有内容。</p><% } %>
  <div class="content-list">
    <% page.posts.each(function(post) { %><%- partial('_partial/content-card', {post: post}) %><% }) %>
  </div>
  <%- partial('_partial/pagination') %>
</section>
