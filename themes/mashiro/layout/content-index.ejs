<section class="content-section">
  <h1 class="section-title"><%= page.title %></h1>
  <% if (!page.posts.length) { %><p class="empty-state">还没有<%= page.title %>内容。</p><% } %>
  <div class="content-list">
    <% page.posts.each(function(post) { %><%- partial('_partial/content-card', {post: post}) %><% }) %>
  </div>
  <%- partial('_partial/pagination') %>
</section>
