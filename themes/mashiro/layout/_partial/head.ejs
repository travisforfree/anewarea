<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% var title = page.title;
     if (is_archive()) title = '归档' + (page.year ? ' · ' + page.year + (page.month ? '/' + page.month : '') : '');
     if (is_category()) title = '分类 · ' + page.category;
     if (is_tag()) title = '标签 · ' + page.tag;
     var description = page.description || (page.excerpt && strip_html(page.excerpt)) || config.description;
  %>
  <title><% if (title) { %><%= title %> | <% } %><%= config.title %></title>
  <% if (description) { %><meta name="description" content="<%= String(description).trim().slice(0, 160) %>"><% } %>
  <% if (page.permalink) { %><link rel="canonical" href="<%= page.permalink %>"><% } %>
  <%- css('/css/style') %>
</head>
